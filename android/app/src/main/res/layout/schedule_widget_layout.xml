<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_schedule_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_schedule_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schedule"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_schedule_header"
        android:background="#20FFFFFF" />

    <!-- Timeline List -->
    <ListView
        android:id="@+id/widget_schedule_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- Current Time Indicator (Fixed at vertical center of the list area) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:paddingTop="0dp">
        
        <!-- We use a helper view to center the line. Since this is a RelativeLayout filling the remaining space, 
             a view with layout_centerInParent="true" will be exactly in the middle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_indicator" />
            
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#4F86F7" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/widget_schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:gravity="center"
        android:text="No events scheduled"
        android:textColor="#60FFFFFF"
        android:visibility="gone" />

</RelativeLayout>
